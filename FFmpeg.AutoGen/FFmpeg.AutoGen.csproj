<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0</TargetFrameworks>
    <Description>
		--- Changes ---
		Added hwcontext for OpenCL, DirectX12, Vulkan and Cuda
        --- BugFix ---
		Last version build for FFmpeg 9.0 (pre)
		
		Based on FFmpeg.AutoGen by Ruslan Balanukhin with minor changes.
		All classes and structs are renamed to start with '_'.
		FFmpeg auto generated unsafe bindings for C#/.NET and Mono.</Description>
	  <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild Condition=" $(Configuration) == 'Release' ">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <NoWarn>108;169;618;1573;1591;1701;1702;1705</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Build symbol package (.snupkg) to distribute the PDB containing Source Link -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>FFmpeg._AutoGen</Title>
    <Product>FFmpeg._AutoGen</Product>
    <Version>8.1.2.2</Version>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  
</Project>
