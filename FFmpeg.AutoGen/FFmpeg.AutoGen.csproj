<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.1;netstandard2.0</TargetFrameworks>
		<PackageReleaseNotes>
			--- 9.0.1.1 ---
			BugFix:
			CLong/CULong had incorrect size (on Windows or 32bit) and netstandard.
			The nuget package contains a windows specific build for netstandard2.0 and netstandard2.1 to fix this issue.
			For unix/linux it maps to IntPtr/UIntPtr, for windows targets it mappes to int/uint.
			Also a _win struct is included if netstandard so that the general build has structs with correct size.
			Cast to the correct type at runtime if necessary. (e.B. _AVIOContext(_win) FormatContext->pb)
		</PackageReleaseNotes>
		<Description>
			Based on FFmpeg.AutoGen by Ruslan Balanukhin with minor changes to use with FFmpegDotNet.
			All classes and structs are renamed to start with '_'.
			FFmpeg auto generated unsafe bindings for C#/.NET and Mono.
		</Description>
		<LangVersion>latest</LangVersion>
		<Description>FFmpeg auto generated unsafe bindings for C#/.NET and Mono.</Description>
		<GeneratePackageOnBuild Condition=" $(Configuration) == 'Release' ">true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<NoWarn>108;169;618;1573;1591;1701;1702;1705;8981</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningsAsErrors />
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Build symbol package (.snupkg) to distribute the PDB containing Source Link -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>FFmpeg._AutoGen</Title>
		<Product>FFmpeg._AutoGen</Product>
		<Version>9.0.1.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
	</ItemGroup>

	<!--
		Windows-specific netstandard2.0 / netstandard2.1 runtime assets.

		Neither netstandard target has CLong/CULong - that only exists from
		.NET 6 onward - so we hand-polyfill it, but the polyfill differs by OS
		(Windows: always 32-bit; everywhere else: nint/nuint). Since a single
		netstandard assembly can't branch on OS at runtime for a *struct
		layout*, we compile a second copy of the exact same sources with
		TARGET_WINDOWS defined (see FFmpeg.AutoGen.win.csproj) and ship it as a
		NuGet "runtime-specific implementation assembly" under runtimes/win/lib/.
		NuGet substitutes it in automatically once a Windows RID is known
		(self-contained publish, apphost, etc.); everyone else keeps using the
		plain lib/netstandardX.X builds produced by this project.

		This only needs to run once for the whole multi-targeted pack, hence the
		Condition="'$(TargetFramework)' == ''" - that's true only during the
		outer, cross-targeting pass that NuGet.Build.Tasks.Pack uses to gather
		package files (_GetPackageFiles), not during each inner TFM build.
	-->
	<ItemGroup>
		<!-- One entry per netstandard TFM that needs a Windows-specific runtime asset -->
		<_WindowsRuntimeTfm Include="netstandard2.0" />
		<_WindowsRuntimeTfm Include="netstandard2.1" />
	</ItemGroup>

	<Target Name="BuildAndIncludeWindowsRuntimeAsset" BeforeTargets="_GetPackageFiles" Condition="'$(TargetFramework)' == ''">

		<MSBuild Projects="$(MSBuildThisFileDirectory)FFmpeg.AutoGen.win.csproj"
				 Targets="Restore;Build"
				 Properties="Configuration=$(Configuration)" />

		<ItemGroup>
			<None Include="$(MSBuildThisFileDirectory)bin\Windows\$(Configuration)\%(_WindowsRuntimeTfm.Identity)\FFmpeg.AutoGen.dll"
				  Pack="true"
				  PackagePath="runtimes/win/lib/%(_WindowsRuntimeTfm.Identity)/" />

			<None Include="$(MSBuildThisFileDirectory)bin\Windows\$(Configuration)\%(_WindowsRuntimeTfm.Identity)\FFmpeg_AutoGen.pdb"
				  Pack="true"
				  PackagePath="runtimes/win/lib/%(_WindowsRuntimeTfm.Identity)/"
				  Condition="'$(IncludeSymbols)' == 'true' And Exists('$(MSBuildThisFileDirectory)bin\Windows\$(Configuration)\%(_WindowsRuntimeTfm.Identity)\FFmpeg_AutoGen.pdb')" />
		</ItemGroup>

	</Target>

</Project>